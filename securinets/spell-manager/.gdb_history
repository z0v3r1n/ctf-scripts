void menu(void)

{
  int char;
  undefined4 choice;
  
  do {
    puts("=== Grimoire Menu ===");
    puts("1. Add Spell");
    puts("2. Edit Spell");
    puts("3. View Spells");
    puts("4. Delete Spell");
    puts("5. Feedback");
    puts("6. Exit");
    printf("Choice: ");
    __isoc99_scanf("%u",&choice);
    do {
      char = getchar();
    } while (char != 10);
    switch(choice) {
    default:
      puts("Invalid choice.\n");
      break;
    case 1:
      add_spell();
      break;
    case 2:
      edit_spell();
      break;
    case 3:
      view_spells();
      break;
    case 4:
      delete_spell();
      break;
    case 5:
      feedback();
      break;
    case 6:
      puts("Exiting...");
      return;
    }
  } while( true );
}





